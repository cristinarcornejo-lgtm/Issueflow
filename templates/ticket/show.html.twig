{#  Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# Sobreescribir el título. Usamos el Id del ticket para construir un título
de página específico #}
{% block title %}{{ ticket.id }} . Issueflow{% endblock %}

{% block body %}
<p>
    <a href="{{ path('app_ticket_index') }}">Volver a incidencias</a>
</p>
<p class=""ticket-id">{{  ticket.id }}</p>
<h1>{{ ticket.title }}</h1>
<p>Prioridad: <strong>{{ ticket.priority.label }}</strong></p>
<p>Estado: <strong>{{ ticket.status.label }}</strong></p>

{#  Agregar el tiempo de respuesta #}

<p>Objetivo de respuesta: {{ responseTargetHours }} horas</p>

  {# Agregamos el mensaje "requiere atencion inmediata" solo
        si el ticket tiene una priority urgente: TicketPriority::Urgent
        Todo lo que este entre el {% if condition %} y el {% endif %}
        aparece en el documento html solo si se cumple la condición #}
    {% if ticket.urgent %}
        <p class="ticket-urgent">Requiere atención inmediata</p>
    {% endif %}
    {# Agregamos el mensaje "Incidencia cerrada" solo
        si el ticket tiene un estado closed #}
    {% if ticket.closed %}
        <p class="ticket-closed">Incidencia cerrada</p>
    {% endif %}
{% endblock %}
